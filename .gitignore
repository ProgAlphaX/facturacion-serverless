# =========================================================
# .gitignore – facturacion-serverless (Grupo 4)
# Lo que está aquí NUNCA se sube al repositorio.
# =========================================================

# ---------- Secretos y configuración local ----------
.env
.env.*
!.env.example

# ---------- Certificados y llaves privadas ----------
# El certificado firma los comprobantes: si se filtra, cualquiera podría firmar a nombre del emisor.
certs/
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.jks

# ---------- Credenciales de la nube ----------
.aws/
credentials
*accessKeys*.csv
*_credentials.csv

# ---------- Terraform ----------
# El state guarda IDs y hasta secretos de la infraestructura: vive en el backend S3, no en Git.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Sí se sube: .terraform.lock.hcl (fija las versiones de los providers)

# ---------- Node.js ----------
node_modules/
coverage/
.nyc_output/
dist/
build/
.npm/
.eslintcache
*.tsbuildinfo
*.tgz
logs/
*.log
npm-debug.log*

# ---------- Docker local ----------
docker-compose.override.yml
/data/

# ---------- Postman ----------
# Los environments guardan tokens y contraseñas.
*.postman_environment.json
!*.example.postman_environment.json

# ---------- Archivos generados por la API ----------
# XML, CDR, ZIP y PDF de prueba se generan al usar la aplicación.
salida/
*.zip

# ---------- Serverless (APF3) ----------
.serverless/

# ---------- Sistema operativo y editores ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------- Documentos del curso ----------
# El informe se trabaja en Word fuera del repositorio.
/*.docx
/*.pdf
~$*
