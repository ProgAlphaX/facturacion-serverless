{
  "name": "facturacion-api",
  "version": "0.2.0",
  "private": true,
  "description": "API de emisión de comprobantes electrónicos SUNAT (UBL 2.1, firma, SOAP, CDR, PDF)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "test": "jest",
    "certificado": "node --env-file-if-exists=../.env scripts/generar-certificado.js"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "xml-crypto": "^6.4.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "node-forge": "^1.4.0",
    "supertest": "^7.3.1"
  }
}
