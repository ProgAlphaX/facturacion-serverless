# Copia este archivo como `.env.local` y completa los valores (el archivo .env.local nunca se sube a git).
# Los valores salen de la pila desplegada: `aws cloudformation describe-stacks --stack-name fe-serverless-dev`.

# Salida UrlApi, incluida la etapa (p. ej. https://abc123.execute-api.us-east-1.amazonaws.com/dev)
API_URL=
COGNITO_REGION=us-east-1
# Salida ClienteApiId
COGNITO_CLIENT_ID=
# aws apigateway get-api-key --api-key <LlaveApiId> --include-value --query value --output text
API_KEY=
