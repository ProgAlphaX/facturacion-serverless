{
  "name": "facturanube-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "entorno": "node scripts/generar-entorno.cjs",
    "prestart": "npm run entorno",
    "prebuild": "npm run entorno",
    "prelint": "npm run entorno",
    "pretest": "npm run entorno",
    "typecheck": "npm run entorno && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.1.0",
