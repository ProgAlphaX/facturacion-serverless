{
  "info": {
    "name": "Facturación Electrónica – Grupo 4 (APF3)",
    "description": "Pruebas de la API de emisión de comprobantes desplegada en AWS (API Gateway + Cognito JWT + API key + Step Functions). Antes de ejecutar, en Variables de la colección (Current value) pon: baseUrl (la URL de la API, termina en /dev), apiKey y jwt (solo el token, sin la palabra Bearer). Ejecutar con el Runner en orden. La petición 12 se corre aparte con 60 iteraciones; el 429 en paralelo lo demuestra el script serverless/scripts/probar-api.ps1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "rucEmisor",
      "value": "20000000001"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy en Perú (UTC-5): la regla R04 no acepta fechas futuras ni de más de 3 días",
          "const lima = new Date(Date.now() - 5 * 60 * 60 * 1000);",
          "pm.collectionVariables.set('fechaHoy', lima.toISOString().slice(0, 10));",
          "",
          "const nombre = pm.info.requestName;",
          "if (!nombre.includes('Sin API key')) {",
          "  pm.request.headers.upsert({ key: 'x-api-key', value: pm.collectionVariables.get('apiKey') });",
          "}",
          "if (!nombre.includes('Sin JWT')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: pm.collectionVariables.get('jwt') });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "02 – Emitir factura válida (ACEPTADO)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Número aleatorio para poder ejecutar la colección varias veces sin chocar con R12",
              "const numero = Math.floor(Math.random() * 90000000) + 1000;",
              "pm.collectionVariables.set('numeroFactura', numero);",
              "pm.collectionVariables.set('idFactura', `${pm.collectionVariables.get('rucEmisor')}-01-F001-${String(numero).padStart(8, '0')}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('responde 201', () => pm.response.to.have.status(201));",
              "pm.test('SUNAT la acepta (CDR 0)', () => {",
              "  pm.expect(r.estado).to.eql('ACEPTADO');",
              "  pm.expect(r.cdr.codigo).to.eql('0');",
              "});",
              "pm.test('devuelve el id y el hash de la firma', () => {",
              "  pm.expect(r.id).to.eql(pm.collectionVariables.get('idFactura'));",
              "  pm.expect(r.hash).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/comprobantes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"01\",\n  \"serie\": \"F001\",\n  \"numero\": {{numeroFactura}},\n  \"fechaEmision\": \"{{fechaHoy}}\",\n  \"moneda\": \"PEN\",\n  \"cliente\": { \"tipoDoc\": \"6\", \"numDoc\": \"20100070970\", \"nombre\": \"CLIENTE DEMO S.A.\" },\n  \"items\": [\n    { \"descripcion\": \"Servicio de consultoría\", \"unidad\": \"ZZ\", \"cantidad\": 2, \"valorUnitario\": 100 },\n    { \"descripcion\": \"Soporte técnico mensual\", \"unidad\": \"ZZ\", \"cantidad\": 1, \"valorUnitario\": 50 }\n  ],\n  \"totales\": { \"valorVenta\": 250, \"igv\": 45, \"total\": 295 }\n}"
        }
      }
    },
