    {
      "name": "08 – Consultar factura emitida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('responde 200 con el comprobante ACEPTADO, su XML y su CDR', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(r.estado).to.eql('ACEPTADO');",
              "  pm.expect(r.archivos).to.include.keys('xml', 'cdr');",
              "});",
              "",
              "// El PDF lo crea el trigger de S3 unos segundos después de emitir: se vuelve a consultar hasta ~30 s",
              "const comprobarPdf = (pdf) => pm.test('el PDF aparece solo (trigger de S3)', () => pm.expect(pdf, 'archivos.pdf').to.be.a('string'));",
              "const consultar = (intento) => {",
              "  pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{baseUrl}}/comprobantes/{{idFactura}}'),",
              "    method: 'GET',",
              "    header: { 'x-api-key': pm.collectionVariables.get('apiKey'), Authorization: pm.collectionVariables.get('jwt') },",
              "  }, (err, res) => {",
              "    const pdf = !err && res.json().archivos && res.json().archivos.pdf;",
              "    if (pdf || intento >= 10) return comprobarPdf(pdf);",
              "    setTimeout(() => consultar(intento + 1), 3000);",
              "  });",
              "};",
              "if (r.archivos && r.archivos.pdf) comprobarPdf(r.archivos.pdf); else consultar(1);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/comprobantes/{{idFactura}}"
      }
    },
