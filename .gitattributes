# Saltos de línea estilo Linux (LF) para todo el texto:
# Docker y la EC2 corren Linux; un script con CRLF (Windows) falla ahí.
* text=auto eol=lf

# Scripts de Windows sí deben quedar con CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos binarios: Git no debe tocarlos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pfx binary
*.p12 binary
