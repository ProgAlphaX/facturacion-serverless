# =========================================================
# Plantilla de configuración – facturacion-serverless
# Copia este archivo como ".env" y completa tus valores.
# El archivo .env NUNCA se sube a GitHub.
# =========================================================

# ---------- General ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------- AWS ----------
AWS_REGION=us-east-1

# ---------- Solo entorno local (Docker) ----------
# Apuntan a los emuladores de docker compose. En AWS no se usan:
# la EC2 usa su rol IAM y no necesita llaves.
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
S3_ENDPOINT=http://s3-local:9090
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------- Recursos ----------
DYNAMODB_TABLE=fe-dev-comprobantes
S3_BUCKET=fe-dev-comprobantes-local

# ---------- SUNAT (ventanilla SOAP) ----------
# En local apunta a la SUNAT simulada (sunat-mock).
# MODDATOS / moddatos son las credenciales públicas del entorno beta de SUNAT.
SUNAT_URL=http://sunat-mock:4000/billService
SUNAT_USUARIO=MODDATOS
SUNAT_CLAVE=moddatos

# ---------- SUNAT simulada (sunat-mock) ----------
SUNAT_MOCK_PORT=4000
# RUCs que el padrón simulado considera dados de baja (rechazo 2017)
RUCS_INACTIVOS=20123456786

# ---------- Emisor ----------
# RUC de prueba válido (dígito verificador correcto)
EMISOR_RUC=20000000001
EMISOR_RAZON_SOCIAL=EMPRESA DEMO S.A.C.

# ---------- Firma digital ----------
# Certificado de prueba; la carpeta certs/ está en .gitignore
CERT_PATH=./certs/certificado.pem
CERT_KEY_PATH=./certs/llave-privada.pem
